POSTGRES_DB=hr_management
POSTGRES_USER=hr_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
API_PORT=8080
WEB_PORT=3000
ORGANIZATION_NAME=Local Organization
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=Replace-With-A-Long-Random-Password-123!
# Optional Development-only demo accounts. Leave empty outside local development.
DEMO_USERS_PASSWORD=
MAX_UPLOAD_BYTES=26214400

# Backend-only AI configuration. Keep both gates false until the DPIA, legal review,
# provider data-processing terms, retention posture, HTTPS, and encrypted backups are approved.
AI_ENABLED=false
AI_REAL_DATA_APPROVED=false
ORGANIZATION_TIMEZONE=Europe/Belgrade
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MONTHLY_BUDGET_USD=50
# Set these to the current prices for the configured model before enabling AI.
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0
